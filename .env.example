# --research runs without a database; --init-db requires connection settings.
PROD=false
COLLECTOR_DB_URL=
# Local example: postgresql+psycopg2://user:password@localhost:5432/macrobond_inhouse
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_HTTP_TIMEOUT=30
COLLECTOR_MAX_RETRIES=2
COLLECTOR_BACKOFF_FACTOR=2
DBX_SERVER_HOSTNAME=
DBX_HTTP_PATH=
AKV_VAULT_URL=
AKV_SECRET_NAME=databricks-token
DATABRICKS_TOKEN=
