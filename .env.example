# Environment switch
# PROD=True uses Databricks; PROD=False uses COLLECTOR_DB_URL.
PROD=false
COLLECTOR_DB_URL=postgresql+psycopg2://user:password@localhost:5432/macrobond_inhouse

# Pipeline
COLLECTOR_START_DATE=1991-01-01
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_POLL_INTERVAL=60
COLLECTOR_MAX_WAIT=900
COLLECTOR_VALIDATION_TOLERANCE_PP=0.10
COLLECTOR_WEIGHT_TOLERANCE_PP=0.005
COLLECTOR_MIN_VALIDATION_COVERAGE=0.99

# HTTP
COLLECTOR_HTTP_TIMEOUT=90
COLLECTOR_DOWNLOAD_DELAY=1
COLLECTOR_MAX_RETRIES=4
COLLECTOR_BACKOFF_FACTOR=2
COLLECTOR_RATE_LIMIT_BACKOFF=20
COLLECTOR_MAX_RETRY_DELAY=120
COLLECTOR_MAX_DOWNLOAD_BYTES=67108864

# rosstat.gov.ru is certified by the Russian national CA, which no default trust
# store carries. Point this at an alternative PEM only if your deployment
# manages that trust elsewhere; TLS verification is never disabled.
COLLECTOR_ROSSTAT_CA_BUNDLE=rosstat_ca_bundle.pem

# Databricks / Azure Key Vault (PROD only)
DBX_SERVER_HOSTNAME=
DBX_HTTP_PATH=
AKV_VAULT_URL=
AKV_SECRET_NAME=databricks-token
DATABRICKS_TOKEN=
